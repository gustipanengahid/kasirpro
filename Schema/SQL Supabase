-- 4. RLS POLICY (DIAMANKAN UNTUK PENGGUNA TEROTENTIKASI)
-- ==========================================

ALTER TABLE categories ENABLE ROW LEVEL SECURITY;
ALTER TABLE items ENABLE ROW LEVEL SECURITY;
ALTER TABLE promos ENABLE ROW LEVEL SECURITY;
ALTER TABLE settings ENABLE ROW LEVEL SECURITY;
ALTER TABLE transactions ENABLE ROW LEVEL SECURITY;
ALTER TABLE users ENABLE ROW LEVEL SECURITY;

-- Hapus policy lama
DROP POLICY IF EXISTS "allow_all_categories" ON categories;
DROP POLICY IF EXISTS "allow_all_items" ON items;
DROP POLICY IF EXISTS "allow_all_promos" ON promos;
DROP POLICY IF EXISTS "allow_all_settings" ON settings;
DROP POLICY IF EXISTS "allow_all_transactions" ON transactions;
DROP POLICY IF EXISTS "allow_all_users" ON users;

-- Akses Publik (Anonim) hanya bisa Membaca Menu/Produk (Untuk Public Menu)
CREATE POLICY "Public Read Categories" ON categories FOR SELECT USING (true);
CREATE POLICY "Public Read Items" ON items FOR SELECT USING (true);
CREATE POLICY "Public Read Promos" ON promos FOR SELECT USING (is_active = true);
CREATE POLICY "Public Read Settings" ON settings FOR SELECT USING (true);

-- Pengguna Terautentikasi (Kasir / Admin) memiliki akses Penuh
CREATE POLICY "Auth Manage Categories" ON categories FOR ALL TO authenticated USING (true) WITH CHECK (true);
CREATE POLICY "Auth Manage Items" ON items FOR ALL TO authenticated USING (true) WITH CHECK (true);
CREATE POLICY "Auth Manage Promos" ON promos FOR ALL TO authenticated USING (true) WITH CHECK (true);
CREATE POLICY "Auth Manage Settings" ON settings FOR ALL TO authenticated USING (true) WITH CHECK (true);
CREATE POLICY "Auth Manage Transactions" ON transactions FOR ALL TO authenticated USING (true) WITH CHECK (true);
CREATE POLICY "Auth Manage Users" ON users FOR ALL TO authenticated USING (true) WITH CHECK (true);


